{
  "expo": {
    "name": "TagSnap",
    "slug": "tagsnap",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tagsnap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1720"
    },
    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tagsnap.field",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "TagSnap uses the camera to photograph scale tickets so they can be turned into line items on your settlement.",
        "NSPhotoLibraryUsageDescription": "TagSnap can attach a scale ticket photo you have already taken.",
        "NSFaceIDUsageDescription": "TagSnap uses Face ID to unlock the app and to confirm submissions.",
        "NSLocationWhenInUseUsageDescription": "TagSnap records where a ticket photo was taken, which lets the office confirm the quarry automatically instead of calling you about it. Location is captured only at the moment you take a photo — the app never tracks you in the background.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },

    "android": {
      "package": "com.tagsnap.field",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1720"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },

    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "TagSnap uses the camera to photograph scale tickets.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TagSnap records where a ticket photo was taken so the office can confirm the quarry automatically.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TagSnap uses Face ID to unlock the app."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#F5A623",
          "defaultChannel": "default"
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },

    "updates": {
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
