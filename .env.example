# TagSnap environment
#
# Copy to the places that need it and fill in real values:
#   apps/web/.env            the VITE_* pair only
#   supabase/.env            everything under "server only"
#   ios/Config.xcconfig      see ios/README.md
#   android/local.properties see android/README.md
#
# The split is the point. Anything with VITE_ in front of it, and everything in
# the two mobile config files, is compiled into a shipped bundle in plaintext —
# anyone can pull the APK or view source and read it. Treat those as meaning
# "published to the internet". Everything under "server only" must never appear
# in any app.

# ---------------------------------------------------------------- public
# Safe to ship. The anon key is public by design; Row Level Security is what
# makes that safe, which is why 002_rls.sql matters more than this file does.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------ server only
# These live in the Supabase edge function environment and nowhere else.
# `supabase secrets set --env-file supabase/.env` puts them there.

# Bypasses every RLS policy. If this ever ends up in an app bundle, every
# driver can read every other driver's pay.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser origins allowed to call the edge functions. The office console only.
# The mobile apps send no Origin header and are unaffected.
ALLOWED_ORIGINS=http://localhost:5173,https://office.yourcompany.com

# ------------------------------------------------------------------- push
# Optional. Without these the apps still work; the office just cannot buzz a
# driver's phone when a ticket is sent back, and they have to look at the
# Tickets tab instead. Both providers are free at any volume this will reach.

# Apple. One .p8 auth key works for every app on the team, for both sandbox and
# production, and never expires. See ios/README.md.
#
# APNS_ENVIRONMENT must match `aps-environment` in TagSnap.entitlements —
# `development` for Xcode builds, `production` for TestFlight and the App
# Store. A token minted in one environment is rejected by the other, and that
# mismatch is the most common reason push "works on my machine".
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tagsnap.field
APNS_ENVIRONMENT=development

# Google. A Firebase service account, used only to mint an access token for the
# FCM v1 send endpoint. Single line. See android/README.md.
FCM_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------- unbuilt
# Google service account JSON, single line, for the rate import and invoice
# export. Read-only on the rate sheet; append-only on the invoice workbook.
# Not implemented — see docs/SETUP.md.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_RATES_SHEET_ID=
GOOGLE_INVOICE_SHEET_ID=

# ------------------------------------------------------------------- gone
# ANTHROPIC_API_KEY is no longer used by anything.
#
# Reading tickets moved onto the phone — Apple Vision on iOS, ML Kit on Android
# — which costs nothing per ticket instead of $0.01-0.03, works with no signal,
# and takes the key out of the deployment entirely. If you set it previously:
#
#   supabase secrets unset ANTHROPIC_API_KEY
#
# See docs/OCR.md for what that trade actually cost, and what it bought.
